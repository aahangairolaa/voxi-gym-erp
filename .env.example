# ─────────────────────────────────────────────────────────────
#  VOXI environment variables
#  Copy this file to ".env" and fill in the values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
#  • Local (docker compose up -d):  postgresql://voxi:voxi@localhost:5432/voxi
#  • Cloud (Neon / Supabase / Vercel Postgres): paste the URL they give you
DATABASE_URL="postgresql://voxi:voxi@localhost:5432/voxi"

# Direct (non-pooled) connection, used by Prisma for schema changes (db push / migrate).
#  • Neon: `neon deploy` fills both DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct)
#  • Local Postgres: use the same value as DATABASE_URL
DATABASE_URL_UNPOOLED="postgresql://voxi:voxi@localhost:5432/voxi"

# Secret used to sign login sessions. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Password given to all demo staff accounts created by the seed script.
SEED_PASSWORD="voxi1234"

# ── Optional features (leave empty to turn off) ──────────────────────────────
# "Continue with Google" — Google Cloud Console → Credentials → OAuth client (Web).
# Authorized redirect URI: https://voxiai.co/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# "Forgot password" emails via resend.com
RESEND_API_KEY=""
EMAIL_FROM="VOXI <no-reply@voxiai.co>"
# Set to "false" to stop public sign-ups (gyms are then created only by VOXI admins)
ALLOW_SIGNUP="true"
# Your public site and how gyms contact you
NEXT_PUBLIC_SITE_URL="https://voxiai.co"
NEXT_PUBLIC_CONTACT_EMAIL="support@voxiai.co"
NEXT_PUBLIC_CONTACT_WHATSAPP=""
