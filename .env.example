# ─────────────────────────────────────────────────────────────
#  VOXI environment variables
#  Copy this file to ".env" and fill in the values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
#  • Local (docker compose up -d):  postgresql://voxi:voxi@localhost:5432/voxi
#  • Cloud (Neon / Supabase / Vercel Postgres): paste the URL they give you
DATABASE_URL="postgresql://voxi:voxi@localhost:5432/voxi"

# Secret used to sign login sessions. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Password given to all demo staff accounts created by the seed script.
SEED_PASSWORD="voxi1234"
